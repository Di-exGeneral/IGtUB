# Copy to .env.local (or .env.development) and adjust as needed.

# Set to "false" once the real backend is live. While unset or "true",
# the app runs entirely on mock data with simulated latency.
VITE_USE_MOCKS=true

# Base URL for real API calls. Leave empty in development to use the Vite
# dev proxy (see vite.config.js); set to e.g. https://api.example.com in prod.
VITE_API_URL=

# Where the dev proxy forwards /api requests.
VITE_PROXY_TARGET=http://localhost:8000
